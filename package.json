{
  "name": "jarvis",
  "displayName": "jarvis",
  "description": "Chat extension for Jarvis, a multi-agent AI Platform Engineer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "jarvis.jarvis",
        "name": "jarvis",
        "fullName": "Jarvis",
        "description": "Hello! What can I do for you?",
        "isSticky": true,
        "disambiguation": [
          {
            "category": "platform_engineering",
            "description": "The user wants to talk about platform engineering or needs help with their platform.",
            "examples": [
                "Can you create a new GitHub repo?",
                "Get RAG Pipeline keys.",
                "I need help with my platform."
            ]
          },
          {
            "category": "cisco",
            "description": "The user wants to talk about Cisco or needs help with their Cisco account.",
            "examples": [
                "Tell me about Cisco.",
                "I need help with my Cisco account."
            ]
          }
        ],
        "commands": [
          {
            "name": "cisco",
            "description": "Tell me about Cisco.",
            "disambiguation": [
              {
                "category": "cisco_info",
                "description": "The user wants to talk about Cisco. They want a general overview about the company.",
                "examples": [
                    "Tell me about Cisco."
                ]
              }
            ]
          },
          {
            "name": "options",
            "description": "What can Jarvis do?",
            "disambiguation": [
              {
                "category": "jarvis_options",
                "description": "The user wants to know what options are available.",
                "examples": [
                    "What can jarvis do?",
                    "What options are available to Jarvis?"
                ]
              }
            ]
          },
          {
            "name": "jira",
            "description": "Talk about Jira."
          },
          {
            "name": "triage",
            "description": "Check who is currently on duty.",
            "disambiguation": [
              {
                "category": "triage_info",
                "description": "The user wants to know who is currently on duty.",
                "examples": [
                    "Who is currently on duty?",
                    "Check who is on duty."
                ]
              }
            ]
          },
          {
            "name": "githubRepo",
            "description": "Create a new GitHub repo.",
            "disambiguation": [
              {
                "category": "github_repo",
                "description": "The user wants to create a new GitHub repo.",
                "examples": [
                    "Create a new GitHub repo.",
                    "I need a new GitHub repo."
                ]
              }
            ]
          },
          {
            "name": "llmAccess",
            "description": "Get LLM access.",
            "disambiguation": [
              {
                "category": "llm_access",
                "description": "The user wants to get LLM access.",
                "examples": [
                    "I need a new LLM key.",
                    "Get me a new LLM key.",
                    "I need LLM access."
                ]
              }
            ]
          },
          {
            "name": "questionDocs",
            "description": "Ask a question about the platform docs.",
            "disambiguation": [
              {
                "category": "docs_question",
                "description": "The user wants to ask a question about the platform docs.",
                "examples": [
                    "I have a question about the platform docs."
                ]
              }
            ]
          },
          {
            "name": "ragKeys",
            "description": "Get RAG Pipeline keys.",
            "disambiguation": [
              {
                "category": "rag_keys",
                "description": "The user wants to get RAG Pipeline keys.",
                "examples": [
                    "Get RAG Pipeline keys.",
                    "I need RAG Pipeline keys."
                ]
              }
            ]
          }
        ]
      }
    ],
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run check",
    "lint": "eslint .",
    "prettier": "npx prettier --check src",
    "check": "npm run lint && npm run prettier",
    "format": "npx prettier --write src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "dependencies": {
    "@vscode/prompt-tsx": "^0.3.0-alpha.24",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0"
  }
}

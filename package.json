{
  "name": "jarvis",
  "displayName": "jarvis",
  "description": "Chat extension for Jarvis, a multi-agent AI Platform Engineer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "jarvis.jarvis",
        "name": "jarvis",
        "fullName": "Jarvis",
        "description": "What would you like to do?",
        "isSticky": true,
        "commands": [
          {
            "name": "cisco",
            "description": "Tell me about Cisco."
          },
          {
            "name": "options",
            "description": "What can you do?"
          },
          {
            "name": "jira",
            "description": "Talk about Jira."
          },
          {
            "name": "triage",
            "description": "Check who is currently on duty."
          },
          {
            "name": "githubRepo",
            "description": "Create a new GitHub repo."
          },
          {
            "name": "llmAccess",
            "description": "Get LLM access."
          },
          {
            "name": "questionDocs",
            "description": "Ask a question about the platform docs."
          },
          {
            "name": "ragKeys",
            "description": "Get RAG Pipeline keys."
          }
        ]
      }
    ],
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run check",
    "lint": "eslint .",
    "prettier": "npx prettier --check src",
    "check": "npm run lint && npm run prettier",
    "format": "npx prettier --write src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "dependencies": {
    "@vscode/prompt-tsx": "^0.3.0-alpha.24",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0"
  }
}
